      "restart_required": true,
      "hint": "只保存在服务器上；控制台只显示已设置或未设置"
    },
    {
      "key": "DSH_ACL",
      "label": "指令权限管控",
      "group": "权限与安全",
      "type": "bool",
      "default": "1",
      "restart_required": true,
      "hint": "限制谁能发管理类指令"
    },
    {
      "key": "DSH_ACL_OWNER",
      "label": "管理员 QQ 号",
      "group": "权限与安全",
      "type": "str",
      "default": "",
      "restart_required": true,
      "hint": "填你自己的 QQ 号，只保存在服务器上，不要写进仓库"
    },
    {
      "key": "DSH_ACL_QUIET",
      "label": "拒绝时静默",
      "group": "权限与安全",
      "type": "bool",
      "default": "0",
      "restart_required": true,
      "hint": "开＝无权限的指令直接忽略，不回复提示"
    },
    {
      "key": "DSH_SCENE_TZ",
      "label": "时区",
      "group": "权限与安全",
      "type": "str",
      "default": "Asia/Shanghai",
      "restart_required": true,
      "hint": "影响「现在几点」这类判断"
    }
  ]
}
