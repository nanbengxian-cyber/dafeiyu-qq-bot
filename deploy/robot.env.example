# 机器人运行配置模板
#
# 复制成 deploy/robot.env 后由控制台或你手工修改。
# ⚠️ robot.env 里可能有密钥，**不要提交到仓库**（.gitignore 已忽略）。
# 格式：KEY=VALUE，一行一个，等号两边不加空格，值不加引号。

# ---- 说话频率 ----
DSH_DECIDE=1
DSH_DECIDE_MIN_GAP=60
DSH_DECIDE_COOLDOWN=600
DSH_DECIDE_DIVE=1

# ---- 说话风格 ----
DSH_HUMAN=1
DSH_HUMAN_SPLIT_RATE=0.7
DSH_TYPO_RATE=0.06
DSH_NOISE=1

# ---- 上下文与记忆 ----
DSH_CTX_KEEP_TURNS=30
DSH_MEM_DECAY=1

# ---- 联网与审核 ----
DSH_WEB_ENABLE=1
DSH_WEB_MOD=1
DSH_WEB_MOD_TIMEOUT=12
# 搜索接口密钥：只在服务器上填，留空表示未设置
DSH_WEB_SEARCH_KEY=

# ---- 权限与安全 ----
DSH_ACL=1
# 管理员 QQ 号：填你自己的，不要写进仓库
DSH_ACL_OWNER=
DSH_ACL_QUIET=0
DSH_SCENE_TZ=Asia/Shanghai
