<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dafeiyu.controller"
    android:versionCode="2"
    android:versionName="1.2.0">

    <!-- minSdk 26 = Android 8.0。压在 26 是因为 JSch 的 SftpATTRS 用到了
         java.time（API 26 才有），再往下压就要引入 desugaring，手写构建链
         会多一整块复杂度。Android 8 以下占比已很小，v1 先不伺候。
         targetSdk 34：Android 12+ 要求显式 exported，低 target 会被拒装。 -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- 只要联网。刻意不要任何别的权限：不读通讯录、不读存储、不要位置。
         这个 App 做的事：连 NapCat WebUI 的 HTTP，和服务器的一条 SSH。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 1.2.0 新增：检查更新 + 下载安装 APK。
         系统安装器（ACTION_VIEW 装 APK）需要这个权限声明 —— 没有它，
         Android 8+ 会直接拒绝「安装未知应用」流程的发起。
         （不会真的额外给 App 什么能力，只是放行系统的安装对话框。） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true">

        <!-- usesCleartextTraffic 必须为 true：NapCat WebUI 默认是明文 HTTP，
             Android 9(API 28) 起默认禁止明文流量，不开这个所有请求直接失败。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1.2.0 新增：给系统安装器提供更新 APK 的 content:// 读取。
             exported=false：只有本 App 显式授予临时读权限时系统安装器才能读。
             grantUriPermissions：允许 ACTION_VIEW 带 FLAG_GRANT_READ_URI_PERMISSION。 -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.dafeiyu.controller.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
